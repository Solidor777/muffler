{
  "name": "muffler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ducks Foundry audio while others speak in a Discord voice channel, via a self-hosted bot relay.",
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint src test && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.48.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.11.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.3.3",
    "sass": "^1.80.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "ws": "^8.18.0"
  }
}
