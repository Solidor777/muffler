# ============================================================
# Muffler Bot — Environment Variables
# Copy this file to .env and fill in all required values.
# ============================================================

# (required) Bot token from the Discord Developer Portal → Bot → Token.
DISCORD_TOKEN=your-bot-token-here

# (required) Application (client) ID from the Discord Developer Portal → General Information.
DISCORD_APP_ID=your-application-id-here

# (required) Guild (server) ID for slash-command registration.
# Enable Developer Mode in Discord Settings → Advanced, then right-click your server.
DISCORD_GUILD_ID=your-guild-id-here

# (optional) TCP port the WebSocket relay listens on. Default: 8080.
WS_PORT=8080

# (optional) Shared secret that Foundry clients must present when connecting to the relay.
# Leave blank for open access (LAN-only deployments). Set this if the relay is publicly
# reachable (port-forward, tunnel, VPS, etc.).
RELAY_TOKEN=
